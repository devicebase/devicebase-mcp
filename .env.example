# API key. Required; the client refuses to send a request without one.
DEVICEBASE_API_KEY=your-api-key-here

# API base URL. Optional; defaults to https://api.devicebase.cn
DEVICEBASE_BASE_URL=https://api.devicebase.cn

# Transport. Optional; defaults to stdio.
#   stdio           for MCP clients that launch the server as a subprocess
#                   (Claude Code, VS Code). The key must come from
#                   DEVICEBASE_API_KEY, since there is no request to read a
#                   header from.
#   streamable-http for clients that connect over HTTP. A per-request
#                   Authorization header wins over DEVICEBASE_API_KEY.
MCP_TRANSPORT=stdio

# Bind address for streamable-http only. Optional; defaults shown.
MCP_HOST=localhost
MCP_PORT=8080
